  },
  "bugs": {
    "url": "https://github.com/Seckcey/pleni/issues"
  },
  "keywords": [
    "plenipo",
    "claude-code",
    "codex",
    "ai-agents",
    "multi-agent",
    "agent-orchestration",
    "dashboard",
    "local-first",
    "developer-tools",
    "grok",
    "kimi-code"
  ],
  "type": "module",
  "bin": {
