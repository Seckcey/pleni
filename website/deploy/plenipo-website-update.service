# getplenipo.com: follow Pleni's published releases and checked website changes.
# Installed to /etc/systemd/system/ on Coastline; see website/README.md in the Pleni repository.
[Unit]
Description=Plenipo website: publish checked website changes and release notes
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
# The account that owns /srv/8west/apps/plenipo-website and may use Docker. The install steps
# fill it in; the service never runs as root.
User=DEPLOY_USER
ExecStart=/srv/8west/apps/plenipo-website/bin/auto-release.sh
# A build is allowed up to 20 minutes; a stuck run is stopped, and the next timer run tries again.
TimeoutStartSec=20min
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=yes
PrivateTmp=yes
